<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title and title !== site.title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ site.url }}/feed.xml">

  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if tags and 'doc' in tags %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">

  {% if date %}
  <meta name="publish-date" content="{{ date | dateToISO }}">
  {% endif %}
  {% if tags and 'doc' in tags and date %}
  <meta property="article:published_time" content="{{ date | dateToISO }}">
  {% if author %}<meta property="article:author" content="{{ author }}">{% endif %}
  {% endif %}

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title or site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">

  {% if tags and 'doc' in tags %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ title }}",
    "description": "{{ description or site.description }}",
    "datePublished": "{{ date | dateToISO }}",
    {% if author %}"author": { "@type": "Person", "name": "{{ author }}" },{% endif %}
    "publisher": { "@type": "Organization", "name": "{{ site.title }}" },
    "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.title }}",
    "description": "{{ site.description }}",
    "url": "{{ site.url }}"
  }
  </script>
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">

  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='12' fill='%23c41e3a'/><text x='50' y='72' font-family='monospace' font-size='70' font-weight='bold' fill='%23fff' text-anchor='middle'>S</text></svg>">

  <!-- Analytics: drop Plausible or Umami snippet here -->
</head>
<body class="{{ bodyClass or '' }}">
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-logo" aria-label="SCREED home">SCREED</a>
      <nav class="site-nav">
        <button data-theme-toggle class="theme-toggle" aria-label="Toggle light and dark theme">
          <span class="toggle-icon" aria-hidden="true"></span>
        </button>
      </nav>
    </div>
  </header>

  <main class="site-main" id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-text">Published in defiance of the mundane · <a href="/">SCREED</a> · {{ "" | dateToYear }}</p>
      <p class="footer-sub">You didn't get this from us.</p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
